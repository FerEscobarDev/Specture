{
  "specture": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/specture-pre-tool-use-tdd-gate.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/specture-pre-tool-use-wait-gate.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
